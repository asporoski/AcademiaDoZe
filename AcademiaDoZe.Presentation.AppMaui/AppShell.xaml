<?xml version="1.0" encoding="UTF-8" ?>

<Shell
    x:Class="AcademiaDoZe.Presentation.AppMaui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Views"
    Title="Academia do Zé">

    <!-- Dashboard -->
    <FlyoutItem Title="Dashboard">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="MaterialIcons"
                Glyph="&#xE871;"
                Size="24" />
        </FlyoutItem.Icon>

        <ShellContent
            ContentTemplate="{DataTemplate views:DashboardListPage}"
            Route="dashboard" />
    </FlyoutItem>

    <!-- Logradouros -->
    <FlyoutItem Title="Logradouros">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="MaterialIcons"
                Glyph="&#xE55F;"
                Size="24" />
        </FlyoutItem.Icon>

        <ShellContent
            ContentTemplate="{DataTemplate views:LogradouroListPage}"
            Route="logradouros" />
    </FlyoutItem>

    <!-- Colaboradores -->
    <FlyoutItem Title="Colaboradores">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="MaterialIcons"
                Glyph="&#xE7EF;"
                Size="24" />
        </FlyoutItem.Icon>

        <ShellContent
            ContentTemplate="{DataTemplate views:ColaboradorListPage}"
            Route="colaboradores" />
    </FlyoutItem>

    <!-- Alunos -->
    <FlyoutItem Title="Alunos">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="MaterialIcons"
                Glyph="&#xE80C;"
                Size="24" />
        </FlyoutItem.Icon>

        <ShellContent
            ContentTemplate="{DataTemplate views:AlunoListPage}"
            Route="alunos" />
    </FlyoutItem>

    <!-- Matrículas -->
    <FlyoutItem Title="Matrículas">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="MaterialIcons"
                Glyph="&#xE8D3;"
                Size="24" />
        </FlyoutItem.Icon>

        <ShellContent
            ContentTemplate="{DataTemplate views:MatriculaListPage}"
            Route="matriculas" />
    </FlyoutItem>

    <!-- Configurações -->
    <FlyoutItem Title="Configurações">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="MaterialIcons"
                Glyph="&#xE8B8;"
                Size="24" />
        </FlyoutItem.Icon>

        <ShellContent
            ContentTemplate="{DataTemplate views:ConfigPage}"
            Route="configuracoes" />
    </FlyoutItem>

</Shell>
